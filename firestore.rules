rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net: Public read is allowed so that all community members,
    // families, and students can browse projects, events, and bitacoras.
    // Writes are strictly gated by schema validation blueprints to prevent corruption or malicious payloads.
    
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // --- Helper Validation Functions ---
    // ID validation to guard against Denial of Wallet and Path Variable injections
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validation Blueprint for Projects
    function isValidProject(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.discipline is string && data.discipline.size() <= 100 &&
             data.phase is int &&
             data.summary is string && data.summary.size() <= 3000;
    }

    // Validation Blueprint for User Profiles
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.group is string && data.group.size() <= 100 &&
             data.gradeOrDept is string && data.gradeOrDept.size() <= 200;
    }

    // Validation Blueprint for Calendar Events
    function isValidEvent(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.type is string && data.type.size() <= 100 &&
             data.date is string && data.date.size() <= 100 &&
             data.time is string && data.time.size() <= 100;
    }

    // Validation Blueprint for Collaboration Requests
    function isValidCollaboration(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.group is string && data.group.size() <= 100;
    }

    // Validation Blueprint for Bitacora Entries
    function isValidBitacora(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.title is string && data.title.size() <= 300 &&
             data.author is string && data.author.size() <= 200 &&
             data.content is string && data.content.size() <= 10000;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId) && isValidUserProfile(request.resource.data);
      allow delete: if true;
    }

    // --- Projects Collection ---
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if isValidId(projectId) && isValidProject(request.resource.data);
      allow delete: if true;
    }

    // --- Events Collection ---
    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isValidId(eventId) && isValidEvent(request.resource.data);
      allow delete: if true;
    }

    // --- Collaborations Collection ---
    match /collaborations/{collabId} {
      allow read: if true;
      allow create, update: if isValidId(collabId) && isValidCollaboration(request.resource.data);
      allow delete: if true;
    }

    // --- Bitacora Collection ---
    match /bitacora/{entryId} {
      allow read: if true;
      allow create, update: if isValidId(entryId) && isValidBitacora(request.resource.data);
      allow delete: if true;
    }
  }
}
